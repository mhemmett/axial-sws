# Data, caches, and generated results (see README/CLAUDE.md — never source-controlled)
data/
pickles/
results/
*.mseed
*.pickle
*.pkl
*.mat

# Figures / generated plots (any location in the repo)
*.png
*.pdf
*.jpg
*.jpeg
*.gif

# PyLith generated output (not source)
pylith_axial/output/
pylith_axial/scenarios/
pylith_axial/mesh/*.msh
pylith_axial/figures/

# Catalog / waveform caches and stray outputs anywhere under scripts/ (not just
# top-level - batch-result/raw-data subdirectories like production_*_results/,
# raw_*_data/, passing_waveforms_data*/ all generate CSVs at arbitrary depth)
scripts/**/*.csv
scripts/**/*.log*
scripts/**/.done_batches/

# DMODELS deformation-model inputs/outputs (data, incl. the MATLAB generator scripts
# themselves - not part of the tracked analysis pipeline)
Axial_Deformation/

# Python / Jupyter cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Vendored package build artifacts
swspy/docs/build/

# OS cruft
.DS_Store
