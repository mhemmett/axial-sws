#SPATIAL.ascii 1
SimpleDB {
  num-values = 3
  value-names =  density  bulk_modulus  shear_modulus
  value-units =  kg/m**3  Pa            Pa
  num-locs = 1
  data-dim = 0    // uniform (constant everywhere)
  space-dim = 3
  cs-data = cartesian {
    to-meters = 1.0e+3   // coordinates in km
    space-dim = 3
  }
}
// x(km)  y(km)  z(km)  density(kg/m3)  bulk_modulus(Pa)   shear_modulus(Pa)
// μ=30 GPa, ν=0.25 → λ=μ=30 GPa, K=λ+2μ/3=50 GPa
// ρ=2900 kg/m³ (basaltic oceanic crust)
0.0  0.0  0.0   2900.0  5.0e10  3.0e10
